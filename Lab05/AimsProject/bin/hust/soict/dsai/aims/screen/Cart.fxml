<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0" prefWidth="1024.0"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1">

    <!-- TOP AREA -->
    <top>
        <VBox>
            <children>
                <MenuBar>
                    <menus>
                        <Menu text="Options">
                            <items>
                                <MenuItem text="View store" />
                                <MenuItem text="View cart" />
                            </items>
                        </Menu>

                        <Menu text="Update store">
                            <items>
                                <MenuItem text="Add Book" />
                                <MenuItem text="Add CD" />
                                <MenuItem text="Add DVD" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>

                <Label text="CART" textFill="#00ffff">
                    <font>
                        <Font size="50.0" />
                    </font>
                    <padding>
                        <Insets left="10.0" />
                    </padding>
                </Label>
            </children>
        </VBox>
    </top>

    <!-- CENTER AREA -->
    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets left="10.0" right="10.0" top="10.0" bottom="10.0" />
            </padding>

            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <padding>
                        <Insets top="10.0" bottom="10.0" />
                    </padding>

                    <children>
                        <Label text="Filter:" />

                        <TextField fx:id="tfFilter" promptText="Enter ID or title" />

                        <RadioButton fx:id="radioBtnFilterId" selected="true" text="By ID">
                            <toggleGroup>
                                <ToggleGroup fx:id="filterCategory" />
                            </toggleGroup>
                        </RadioButton>

                        <RadioButton fx:id="radioBtnFilterTitle"
                                     text="By Title"
                                     toggleGroup="$filterCategory" />
                    </children>
                </HBox>

                <TableView fx:id="tblMedia" prefHeight="560.0" prefWidth="700.0">
                    <columns>
                        <TableColumn fx:id="colMediaTitle" prefWidth="300.0" text="Title" />
                        <TableColumn fx:id="colMediaCategory" prefWidth="250.0" text="Category" />
                        <TableColumn fx:id="colMediaCost" prefWidth="150.0" text="Cost" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <ButtonBar>
                    <buttons>
                        <Button fx:id="btnPlay"
                                mnemonicParsing="false"
                                onAction="#btnPlayPressed"
                                text="Play" />

                        <Button fx:id="btnRemove"
                                mnemonicParsing="false"
                                onAction="#btnRemovePressed"
                                text="Remove" />
                    </buttons>
                </ButtonBar>
            </children>
        </VBox>
    </center>

    <!-- RIGHT AREA -->
    <right>
        <VBox alignment="TOP_CENTER" spacing="20.0" prefWidth="220.0">
            <padding>
                <Insets top="50.0" left="10.0" right="10.0" />
            </padding>

            <children>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label text="Total:">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>

                        <Label fx:id="lblTotalCost" text="0 $" textFill="#00ffff">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <Button fx:id="btnPlaceOrder"
                        mnemonicParsing="false"
                        onAction="#btnPlaceOrderPressed"
                        text="Place Order"
                        textFill="WHITE"
                        style="-fx-background-color: red;">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </right>

</BorderPane>